ns hex {
    //  Time Complexity: 4@+34
    // Space Complexity: 4@+50
    //   .mul.add_carry_dst : res   +=   x * .mul.dst + .mul.add_carry_dst
    //
    // .mul.add_carry_dst, res, x, .mul.dst, they are all hex.
    // @requires hex.add.init & hex.mul.init (or hex.init)
    def add_mul res, x @ ret < .mul.dst, .add.dst, .mul.ret, .tables.res {
        .xor .mul.dst+4, x
        .xor .add.dst, res
        wflip .mul.ret+w, ret, .mul.dst
        pad 4
      ret:  // meanwhile - make @+24 fj ops there
        wflip .mul.ret+w, ret
        .xor_zero res, .tables.res
    }

    //  Time Complexity: n(3@+38)
    // Space Complexity: n(3@+54)
    //   res[n] += a[n] * b[1]
    //
    // b must not be one of res's hexes (it is read again at the end; else every later multiply is wrong).
    // res must not overlap a, except res == a.
    // @requires hex.add.init & hex.mul.init (or hex.init)
    def add_mul n, res, a, b {
        rep(n > 0, i) .mul.chain n, res, a, b
        rep(n == 0, i) .mul.clear_carry
    }

    //  Time Complexity: n(4@+39)
    // Space Complexity: n(4@+82)
    //   x[n] *= 10
    //
    // @requires hex.add.init & hex.mul.init (or hex.init)
    // @Assumes: n >= 1.
    def mul10 n, x @ four, end {
        .add_mul n, x, x, four
        .shl_bit n, x
        ;end

      four: hex.hex 4
      end:
    }

    //  Time Complexity: n^2(3@+7) + n*b(3@+38)
    //       for b==n/2: n^2(4.5@+26)
    // Space Complexity: n(20@+481)
    //
    //   res[:n] = a[:n] * b[:n]
    //
    // b is the minimum of #on-bits in a,b (b<n/2 on average, e.g. b=7 for n=16).
    // @requires hex.add.init & hex.mul.init & hex.cmp.init (or hex.init)
    // res,a,b are hex[:n]; res must not alias a or b.
    // @Assumes: n >= 1.
    def mul n, res, a, b @ a_less_1bits, b_less_1bits, loop, after_add, dst, src, end {
        .zero n, dst
        .zero n, src
        .zero n, res

        // if a is the smaller (unsigned) - jump to a_less_1bits (a is the loop operand). else jump to b_less_1bits
        .cmp n, a, b, a_less_1bits, a_less_1bits, b_less_1bits

        a_less_1bits:
        .xor n, dst, b
        .xor n, src, a
        ;loop

        b_less_1bits:
        .xor n, dst, a
        .xor n, src, b


      loop:
        .if0 src, after_add
        .add_mul n, res, dst, src
      after_add:
        .shl_hex n, dst
        .shr_hex n, src
        .if  n, src, end, loop      // can be replaced with #n-sized index decrement and check.


      dst: hex.vec n
      src: hex.vec n
      end:
    }

    ns mul {
        //  Time Complexity: 3@+24
        // Space Complexity: 3@+9
        // @requires hex.add.init & hex.mul.init (or hex.init)
        def clear_carry @ return < .ret {
            .chained_clear_carry 0
          return:
            wflip .ret+w, return
        }

        //  Time Complexity: n(3@+38)
        // Space Complexity: n(3@+54)
        //   res[n] += a[n] * b[1]
        //
        // The two clear_carry dances and the n add_mul dances are one chain of .ret jumps (see chain_step).
        // @Assumes: n >= 1.
        // b must not be one of res's hexes (it is read again at the end; else every later multiply is wrong).
        // @requires hex.add.init & hex.mul.init (or hex.init)
        def chain n, res, a, b @ head, tail, return < .dst, .ret, ..tables.res {
            ..xor .dst, b
            .chained_clear_carry 0
          head:
            .chained_add_mul res, a, head
            rep(n-1, i) .chain_step res+i*dw, res+(i+1)*dw, a+(i+1)*dw
          tail:
            ..xor_zero res+(n-1)*dw, ..tables.res
            .chained_clear_carry tail
          return:
            wflip .ret+w, return
            ..xor .dst, b
        }

        //  Time Complexity: 2@+30      (2.5@+26 when prev_return is 0)
        // Space Complexity: 2@+15      (2.5@+11 when prev_return is 0)
        //   The chained form of clear_carry: .ret = this macro's end (it was prev_return).
        // @Assumes: .ret holds prev_return (0 if it's clear). Like hex.tables.chained_jump, but for .ret:
        //   until the chain clears .ret, no other .ret user (add_mul, mul, clear_carry) may run inside it.
        // @requires hex.add.init & hex.mul.init (or hex.init)
        def chained_clear_carry prev_return @ return < .ret, .add_carry_dst {
            ..add.clear_carry
            wflip .ret+w, prev_return ^ return
            .add_carry_dst+dbit+9; .add_carry_dst
            pad 16
          return:
        }

        //  Time Complexity: 2@+34      (when chained; see hex.tables.chained_jump)
        // Space Complexity: 2@+26
        //   The chained form of add_mul: jumps to the add_mul flow of x, and returns to this macro's end,
        //   with the result in hex.tables.res (not yet xored into res).
        // @Assumes: .ret holds prev_return (see chained_clear_carry).
        //
        // res, x are hex.
        // @requires hex.add.init & hex.mul.init (or hex.init)
        def chained_add_mul res, x, prev_return @ return < .dst, ..add.dst, .ret {
            ..xor .dst+4, x
            ..xor ..add.dst, res
            wflip .ret+w, prev_return ^ return, .dst
            pad 16
          return:
        }

        //  Time Complexity: 3@+38
        // Space Complexity: 3@+54
        //   prev_res ^= hex.tables.res;  hex.tables.res = 0
        //   then chained_add_mul res, x (chained to the previous step's end).
        // @Assumes: the previous step's end is this macro's start (see hex.tables.chained_jump).
        //
        // prev_res, res, x are hex.
        // @requires hex.add.init & hex.mul.init (or hex.init)
        def chain_step prev_res, res, x @ start < ..tables.res {
          start:
            ..xor_zero prev_res, ..tables.res
            .chained_add_mul res, x, start
        }

        //  Time Complexity: 32 (when jumping to dst, until finished)
        // Space Complexity: 1620+@
        // This is where the add_mul "truth" tables are.
        // @output-param ret: The return address. Jumps to it after finishing the add_mul flow.
        // @output-param dst: hex[:2] variable. The code calculates dst[0]*dst[1] + add_carry_dst.
        //                    dst[1] is zeroed after finishing this multiplication.
        // @output-param add_carry_dst: hex variable. It's value is added to dst[0]*dst[1], and the carry is written back to it.
        // @requires hex.tables.init_shared & hex.add.init (or hex.init)
        def init @ add_res, after_add, end,   switch_small_table, add_carry_small_table, set_carry_small_table, \
                clean_small_table,   switch, set_carry_0, set_carry_1, clean,   add_carry, clean_add, clean_carry \
                < ..add.dst, ..tables.ret > ret, dst, add_carry_dst {
            // general progression (after jumping to hex.mul.dst with value d):
            //  1. dst           -> switch+d          (set lower4  mul result in add_carry_dst+4)                                                                     (runtime=5)
            //  2. add_carry_dst -> add_carry+?       (set         add result in hex.add.dst  +4. sets dst to set_carry_{0/1}. sets add_carry_dst to clean_add)       (runtime=6)
            //  3. add_carry_dst -> clean_add+?       (clears the all 8 bits of add_carry_dst.    sets add_carry_dst back to add_carry)                               (runtime=9)
            //  4. dst           -> set_carry_{0/1}+d (set higher4 mul result in add_carry_dst+0. sets dst to clean)                                                  (runtime=5)
            //  5. add_res       -> dst-table+??      (set         add result in hex.tables.res    +0)                                                                (runtime=@-8)
            //  6. dst           -> clean+d           (clears the higher4 bits of dst.            sets dst back to switch)                                            (runtime=6)
            //  7. hex.mul.ret   -> ...                                                                                                                               (runtime=1)


            ;end

          ret: ;0
          dst: ;switch

          add_carry_dst: ;add_carry   // the 4-bit carry is in the lower 4bits in here


          add_res:
            wflip ..tables.ret+w, after_add, ..add.dst
            pad 256
          after_add:
            wflip ..tables.ret+w, after_add, .dst


            pad 16  // not really needed
          switch_small_table:
            rep(16, d) stl.fj \
                (d==0)              ? 0              :  (.add_carry_dst + dbit + (#d) + 3), \
                (d==((1<<(#d))>>1)) ? .add_carry_dst :  switch_small_table + (d^((1<<(#d)) >> 1))*dw
          set_carry_small_table:
            rep(16, d) stl.fj \
                (d==0)              ? 0       :  (.add_carry_dst+dbit+(#d)-1), \
                (d==((1<<(#d))>>1)) ? add_res :  set_carry_small_table + (d^((1<<(#d)) >> 1))*dw
          add_carry_small_table:
            rep(16, d) stl.fj \
                (d==0) ? .add_carry_dst+dbit+8 :  (..add.dst+dbit+(#d)+3), \
                (d==0) ? .add_carry_dst        : add_carry_small_table+(d^((1<<(#d))>>1))*dw
          clean_small_table:
            rep(16, d) stl.fj \
                (d==0) ? .dst+dbit+9 :  (.dst+dbit+(#d)+3), \
                (d==0) ? .ret        :  clean_small_table + (d^((1<<(#d)) >> 1))*dw


            pad 1024
          switch:
            rep(256, d) stl.fj              0,    switch_small_table    + (((d&0xf)*(d>>4)) & 0xf) * dw
          set_carry_0:
            rep(256, d) stl.fj    .dst+dbit+9,    set_carry_small_table +  (((d&0xf)*(d>>4)) >> 4) * dw
          set_carry_1:
            rep(256, d) stl.fj    .dst+dbit+8,    set_carry_small_table + ((((d&0xf)*(d>>4)) >> 4)+1) * dw
          clean:
            rep(256, d) stl.fj    .dst+dbit+8,    clean_small_table     +    (d>>4) * dw


            pad 1024  // needs to be 1024-padded
          add_carry:
            rep(256, d) stl.fj \
                .dst+dbit + (((d&0xf)+(d>>4) > 0xf) ? 9 : 8), \
                add_carry_small_table + (((d&0xf)+(d>>4)) & 0xf) * dw
          clean_add:
            rep(256, d) stl.fj \
                (d==0) ? .add_carry_dst+dbit+8 : (.add_carry_dst+dbit+(#d)-1), \
                (d==0) ? .dst                  : clean_add  +(d^((1<<(#d))>>1))*dw
          clean_carry:
            rep( 16, d) stl.fj \
                (d==0) ? .add_carry_dst+dbit+9 : (.add_carry_dst+dbit+(#d)-1), \
                (d==0) ? .dst                  : clean_carry+(d^((1<<(#d))>>1))*dw


          end:
        }
    }
}



// ---------- Truncated, Constant and Fixed-Point Multiplication


ns hex {
    //  Time Complexity: n^2(1.5@+19) + n(10.5@+73)
    // Space Complexity: n^2(1.5@+27) + n(10.5@+102)
    //   res[:n] = a[:n] * b[:n]    (the low n hexes of the product, like hex.mul)
    //
    // A truncated schoolbook: row j adds a[:n-j] * b[j] into res[j:n] (skipped when b[j] is 0). Unrolled: its time
    //   depends on b's zero hexes, not on its on-bits (as hex.mul's does).
    // res,a,b are hex[:n]; res must not alias a or b.
    // @requires hex.add.init & hex.mul.init (or hex.init)
    def mul_low n, res, a, b {
        .zero n, res
        rep(n, j) .mul_low.row n, j, res, a, b+j*dw
    }
    ns mul_low {
        //  Time Complexity: (m-j)(3@+38)
        // Space Complexity: (m-j)(3@+54)
        //   res[j:m] += wa[:m-j] * wbj    (skipped when wbj is 0)
        // res is hex[:m], wa is hex[:m-j], wbj is a hex.
        // @requires hex.add.init & hex.mul.init (or hex.init)
        def row m, j, res, wa, wbj @ skip {
            ..if0 wbj, skip
            ..add_mul m-j, res+j*dw, wa, wbj
          skip:
        }
    }

    //  Time Complexity: n^2(12@+28) + n*b(6@+76)     (hex.mul's at 2n; b <= 2n is the non-zero hexes of the operand with fewer on-bits)
    // Space Complexity: n(48@+1066)
    //   dst[:n] = (a[:n] * b[:n]) >> 4f    (signed fixed-point multiply)
    //
    // a,b,dst are signed Q-format hex[:n] with f fraction-hexes (dst may alias a/b).
    // The product is computed at full 2n-hex width (no intermediate overflow), then shifted right by the
    //   (hex-aligned) fraction. The result is truncated to n hexes (wraps modulo 2^4n).
    // @Assumes: 0 < f <= n.
    // @requires hex.add.init & hex.mul.init & hex.cmp.init (or hex.init)
    def fixed_mul n, f, dst, a, b @ wide_a, wide_b, product, end {
        .mov n, wide_a, a
        .sign_extend 2*n, n, wide_a
        .mov n, wide_b, b
        .sign_extend 2*n, n, wide_b
        .mul 2*n, product, wide_a, wide_b
        .mov n, dst, product+f*dw
        ;end

      wide_a: .vec 2*n
      wide_b: .vec 2*n
      product: .vec 2*n
      end:
    }

    //  Time Complexity: (n^2/2 + nf)(3@+38)     (+ f^2(1.5@+19) when b is negative)
    // Space Complexity: (n+f)^2(1.5@+27)
    //   dst[:n] = (a[:n] * b[:n]) >> 4f    (signed fixed-point multiply - the same result as fixed_mul)
    //
    // Computes only the n+f low hexes of the product (the only ones the result can see), with mul_low's rows:
    //   n rows on b's hexes, and f rows on its sign-extension hexes (0xf, and only if b is negative).
    // a,b,dst are signed Q-format hex[:n] with f fraction-hexes (dst may alias a/b).
    // @Assumes: 0 < f <= n.
    // @requires hex.add.init & hex.mul.init (or hex.init)
    def fixed_mul_low n, f, dst, a, b @ wide_a, product, sign_hex, negative, positive, end {
        .mov n, wide_a, a
        .sign_extend n+f, n, wide_a
        .zero n+f, product
        rep(n, j) .mul_low.row n+f, j, product, wide_a, b+j*dw
        .sign n, b, negative, positive
      negative:
        rep(f, k) .mul_low.row n+f, n+k, product, wide_a, sign_hex
      positive:
        .mov n, dst, product+f*dw
        ;end

      wide_a: .vec n+f
      product: .vec n+f
      sign_hex: .hex 0xf
      end:
    }

    //  Time Complexity: on*n(3@+14) + (#c-1)n(@+1)          (on = the on-bits of c)
    // Space Complexity: on*n(3@+54) + (#c-1)n(@+28)
    //   dst[:n] = src[:n] * c    (c is a constant, c >= 0)
    //
    // The strength-reduced constant multiply: every on-bit of c adds a shifted src. No multiplication tables.
    // dst,src are hex[:n] (dst may alias src).
    // @requires hex.add.init (or hex.init)
    // @Assumes: n >= 1.
    def mul_const n, dst, src, c @ shifted, end {
        .mov n, shifted, src
        .zero n, dst
        rep(#c, i) .mul_const.step n, dst, shifted, (c>>i)&1, i < (#c)-1
        ;end

      shifted: .vec n
      end:
    }
    ns mul_const {
        //  Time Complexity: on*n(3@+14) + shift*n(@+1)
        // Space Complexity: on*n(3@+54) + shift*n(@+28)
        //   if on: dst[:n] += shifted[:n]
        //   if shift: shifted[:n] <<= 1
        // on, shift are constants (0/1).
        // @requires hex.add.init (or hex.init)
        def step n, dst, shifted, on, shift {
            rep(on, i) ..add n, dst, shifted
            rep(shift, i) ..shl_bit n, shifted
        }
    }
}
