// ---------- Read Pointers


ns hex {
    //  Time Complexity: w( 0.5@+ 4) + 7@+13
    // Space Complexity: w( 0.5@+22) + 7@+48
    //   like:  dst = *ptr
    // dst is a hex. ptr is a hex[:w/4] that holds an address, which we assume is dw-aligned.
    def read_hex dst, ptr {
        .zero dst
        .xor_hex_from_ptr dst, ptr
    }

    //  Time Complexity: w( 0.5@+ 4) + 9@+13
    // Space Complexity: w( 0.5@+22) + 9@+72
    //   like:  dst[:2] = *ptr
    // dst is a hex[:2]. ptr is a hex[:w/4] that holds an address, which we assume is dw-aligned.
    def read_byte dst, ptr {
        .zero 2, dst
        .xor_byte_from_ptr dst, ptr
    }

    //  Time Complexity: w(0.5@+4) + (5+2*PTR_CELL_BITS/4)@+13
    // Space Complexity: w(0.5@+22) + (5+2*PTR_CELL_BITS/4)@+24 + 24(PTR_CELL_BITS/4)
    //   like:  dst[:PTR_CELL_BITS/4] = *ptr
    //   Reads a WHOLE CELL - all PTR_CELL_BITS bits - in ONE dereference.
    // dst is a hex[:PTR_CELL_BITS/4]. ptr is a hex[:w/4] holding a dw-aligned address.
    // @note: at the default PTR_CELL_BITS=8 this is exactly read_byte.
    def read_cell dst, ptr {
        .zero .pointers.PTR_WIDE/4, dst
        .xor_cell_from_ptr dst, ptr
    }
}



// ---------- Multi Read Pointers


ns hex {
    //  Time Complexity: w( 0.5@+ 4) + 16@+27
    // Space Complexity: w(0.88@+25) + 12@+103
    //   like:  dst = *ptr
    //          ptr++
    // dst is a hex. ptr is a hex[:w/4] that holds an address, which we assume is dw-aligned.
    def read_hex_and_inc dst, ptr {
        .read_hex dst, ptr
        .ptr_inc ptr
    }

    //  Time Complexity: n(w( 0.5@+ 4) + 16@+27)
    // Space Complexity: n(w(0.88@+25) + 12@+103)
    //   like:  dst[:n] = *ptr[:n]
    // dst is a hex[:n]. ptr is a hex[:w/4] that holds an address, which we assume is dw-aligned.
    def read_hex n, dst, ptr {
        rep(n, i) .read_hex_and_inc dst + i*dw, ptr
        .ptr_sub ptr, n
    }

    //  Time Complexity: w( 0.5@+ 4) + 18@+27
    // Space Complexity: w(0.88@+25) + 14@+127
    //   like:  dst[:2] = *ptr
    //          ptr++
    // dst is a hex[:2]. ptr is a hex[:w/4] that holds an address, which we assume is dw-aligned.
    def read_byte_and_inc dst, ptr {
        .read_byte dst, ptr
        .ptr_inc ptr
    }

    //  Time Complexity: n(w( 0.5@+ 4) + 18@+27)
    // Space Complexity: n(w(0.88@+25) + 14@+127)
    //   like:  dst[:2n] = *ptr[:n]
    // dst is a hex[:2n]. ptr is a hex[:w/4] that holds an address, which we assume is dw-aligned.
    def read_byte n, dst, ptr {
        rep(n, i) .read_byte_and_inc dst + i*2*dw, ptr
        .ptr_sub ptr, n
    }
}

ns hex {
    //   like:  dst[:PTR_WIDE/4] = *ptr ; ptr++
    //   One WIDE cell, then advance one cell -- the pair-walking form of read_cell.
    def read_cell_and_inc dst, ptr {
        .read_cell dst, ptr
        .ptr_inc ptr
    }
}

// ---------- Indexed (nth) Read Pointers


ns hex {
    //  Time Complexity:  w(2.75@+9.25) + 7@+13
    // Space Complexity:  w(2.75@+62)    + 7@+48
    // @note: The complexity is calculated for w=64. For w=32/16, add 0.25@/0.5@ in both complexities.
    //   dst = *(ptr + index*2w)   — read the index-th hex past *ptr.
    // dst is a hex; ptr is a hex[:w/4]; index is a signed hex[:w/4] (may be negative). ptr,index preserved.
    // @requires hex.init and stl.ptr_init (or stl.startup_and_init_all).
    def read_nth_hex dst, ptr, index < hex.pointers.nth_ptr {
        .ptr_index hex.pointers.nth_ptr, ptr, index
        .read_hex dst, hex.pointers.nth_ptr
    }

    //  Time Complexity:  w(2.75@+9.25) + 9@+13
    // Space Complexity:  w(2.75@+62)    + 9@+72
    // @note: The complexity is calculated for w=64. For w=32/16, add 0.25@/0.5@ in both complexities.
    //   dst[:2] = *(ptr + index*2w)   — read the index-th byte past *ptr.
    // dst is a hex[:2]; ptr is a hex[:w/4]; index is a signed hex[:w/4] (may be negative). ptr,index preserved.
    // @requires hex.init and stl.ptr_init (or stl.startup_and_init_all).
    def read_nth_byte dst, ptr, index < hex.pointers.nth_ptr {
        .ptr_index hex.pointers.nth_ptr, ptr, index
        .read_byte dst, hex.pointers.nth_ptr
    }
}
