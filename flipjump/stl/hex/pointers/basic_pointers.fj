ns hex {
    ns pointers {
        // NOTE: must be placed just after the startup, so that the read_ptr_byte_table will be at op
        //       exactly 2^PTR_CELL_BITS (256 by default).
        //
        // Space Complexity: 0.5w + 2^PTR_CELL_BITS + PTR_CELL_BITS/4 + 3   (= 0.5w+261 at PTR_CELL_BITS=8)
        //   Initializes the global opcodes and pointer-copies required for the pointers macros.
        //   Initializes the read-byte-handling table and the result/return variables to the read-byte table.
        //
        // @output-param read_byte:  hex[:2] variable. You want to zero it before jumping into ptr_jump.
        //                           After jumping into ptr_jump, it's xored with the read byte.
        // @output-param ret_after_read_byte:  The return address. Jumps to it after finishing reading a byte.
        //
        // @output-param to_flip:  address of opcode that holds a flipping address in its first word. jumping into it will flip wanted bit.
        // @output-param to_jump:  address of opcode that holds a jumping address in its second word. jumping into it will jump to the wanted address.
        // @output-param to_ptr_var:  the hex-vector (pointer) that shadows BOTH of them. The two address
        //                            fields sit in different parts of different opcodes - to_flip's first
        //                            word, to_jump's second - but they always hold the one address being
        //                            pointed at, so a single shadow serves both.
        def ptr_init @ read_ptr_byte_table > to_flip, to_jump, to_ptr_var, \
                                             read_byte, ret_after_read_byte, nth_ptr {
            // PTR_CELL_BITS is a -D knob, so its contract is enforced here rather than only
            // stated: a bad width does not fault, it silently returns the wrong value (7
            // reads 0x41 back as 0x01) or wild-jumps (4, because the byte API writes two
            // hexes into a register sized PTR_CELL_BITS/4). rep() of an undefined macro is
            // the assemble-time failure, and it names the rule it broke.
            rep(.PTR_CELL_BITS % 4 != 0, i) \
                .PTR_CELL_BITS__must_be_a_multiple_of_4
            rep(.PTR_CELL_BITS < 8, i) \
                .PTR_CELL_BITS__must_be_at_least_8__the_byte_api_needs_two_hexes
            rep(dbit + .PTR_CELL_BITS >= dw, i) \
                .PTR_CELL_BITS__must_leave_dbit_plus_it_below_dw

            pad 1<<.PTR_CELL_BITS
          // Time Complexity: PTR_CELL_BITS (when jumping to hex.pointers.to_jump, until finished)
          //   -- one step per SET bit of the value, so 4 for a hex, 8 for a byte.
          //
          // Entry d flips d's top set bit into read_byte and jumps to entry d-without-it, so
          // landing on entry V xors V into read_byte in popcount(V) steps. Bit number (#d)-1
          // lives in hex (#d-1)/4 of read_byte, at bit (#d-1)%4 of it.
          read_ptr_byte_table:
            rep(1<<.PTR_CELL_BITS, d) stl.fj \
                d==0 ? 0 : (.read_byte + (((#d)-1)/4)*dw + dbit + ((#d)-1)%4), \
                (d==((1<<(#d))>>1)) ? .ret_after_read_byte : read_ptr_byte_table+(d^((1<<(#d))>>1))*dw

          // the WIDE table, laid only when PTR_WIDE_BITS asks for it. Same construction at op
          // 2^PTR_WIDE_BITS instead, so a slot armed with dbit+PTR_WIDE_BITS lands HERE and
          // one armed with dbit+PTR_CELL_BITS lands in the narrow table above. The flipped
          // bit is what selects the table, which is why both can coexist.
            rep(.PTR_WIDE_BITS > 0, i) .wide_table_init

          // PLACEMENT, not decoration: `to_flip` FIRST, so it lands on the op right after the
          // decoder table -- op 2^PTR_CELL_BITS * 2, i.e. bit address 0x8000 at the defaults.
          // A wflip costs popcount of the value it flips, and to_flip's own address is flipped
          // on every dereference the program makes; at 0x8000 that popcount is 1, where the
          // previous slot (0x80C0, third in this block) made it 3. Measured on doom-flipjump:
          // 11,026 flips of this value per median frame, so 22,052 executed ops saved, for zero
          // ops of space -- it is a reorder, not a pad.
          // Nothing here is adjacency-sensitive: set_flip_and_jump_pointers addresses to_flip,
          // to_jump+w and to_ptr_var independently, and the read/write dances offset to_flip by
          // compile-time constants only.
          to_flip:
            0;0
          to_jump:
            ;0

          // the destination of a read: as wide as the WIDER of the two tables.
          read_byte:
            hex.vec .PTR_WIDE/4
          ret_after_read_byte:
            ;0

          to_ptr_var:
            hex.vec w/4, 0

          // Shared scratch pointer for the indexed read_nth_*/write_nth_* macros.
          nth_ptr:
            hex.vec w/4, 0
        }

        // Space Complexity: 2^PTR_WIDE_BITS   (nothing at all when PTR_WIDE_BITS is 0)
        //   The wide decoder table. It is a separate macro only so that ptr_init can emit
        //   it conditionally; it must begin at op exactly 2^PTR_WIDE_BITS, which is what
        //   the pad is for, and it shares hex.pointers.read_byte with the narrow table.
        def wide_table_init @ read_ptr_wide_table < .read_byte > ret_after_read_wide {
            rep(.PTR_WIDE_BITS % 4 != 0, i) \
                .PTR_WIDE_BITS__must_be_a_multiple_of_4
            rep(.PTR_WIDE_BITS < 8, i) \
                .PTR_WIDE_BITS__must_be_at_least_8
            rep(dbit + .PTR_WIDE_BITS >= dw, i) \
                .PTR_WIDE_BITS__must_leave_dbit_plus_it_below_dw
            rep(.PTR_WIDE_BITS <= .PTR_CELL_BITS, i) \
                .PTR_WIDE_BITS__must_be_wider_than_PTR_CELL_BITS

            pad 1<<.PTR_WIDE_BITS
          read_ptr_wide_table:
            rep(1<<.PTR_WIDE_BITS, d) stl.fj \
                d==0 ? 0 : (.read_byte + (((#d)-1)/4)*dw + dbit + ((#d)-1)%4), \
                (d==((1<<(#d))>>1)) ? .ret_after_read_wide : read_ptr_wide_table+(d^((1<<(#d))>>1))*dw
          ret_after_read_wide:
            ;0
        }

        //  Time Complexity: w(0.5@+4)
        // Space Complexity: w(0.5@+22)
        //   Sets to_flip, to_jump and their shared shadow to point to the given pointer.
        //   (  to_flip = to_jump{+w} = to_ptr_var = ptr  )
        //
        //   Two passes over the pointer's hexes, not three: one k=3 xor clears all three fields,
        //   a second sets them. A shadow per address field needed a clearing pass EACH, which is
        //   where the extra quarter-w used to go.
        //
        // @Invariant: to_flip == to_jump+w == to_ptr_var on entry to, and on exit from, every one
        //   of the three setters. The macros that offset to_flip by a compile-time constant -
        //   read_byte_from_inners_ptrs (dbit+8), ptr_flip_dbit (dbit), xor_hex_to_flip_ptr (its
        //   gray walk) and ptr_wflip (its advance) - each restore it before they end, so none of
        //   them observes or breaks the invariant.
        // ptr is a hex[:w/4] that holds an address.
        def set_flip_and_jump_pointers ptr < .to_flip, .to_jump, .to_ptr_var {
            ..address_and_variable_triple_xor w/4, .to_flip, .to_jump+w, .to_ptr_var, .to_ptr_var
            ..address_and_variable_triple_xor w/4, .to_flip, .to_jump+w, .to_ptr_var, ptr
        }

        //  Time Complexity: w(0.5@+4)
        // Space Complexity: w(0.5@+22)
        //   Sets to_jump - and with it to_flip and the shared shadow - to point to the given pointer.
        //   (  to_jump{+w} = to_flip = to_ptr_var = ptr  )
        //
        // @note: this is an ALIAS of set_flip_and_jump_pointers, and it must stay one. A setter that
        //   wrote only to_jump would leave to_flip holding an older address while the shadow held the
        //   new one, and the NEXT setter would then xor the wrong value out of to_flip and aim it at
        //   (older ^ new ^ next). That is not a slow path, it is a wild jump. hex.ptr_jump - and so
        //   stl.return - reaches here.
        // ptr is a hex[:w/4] that holds an address.
        def set_jump_pointer ptr {
            .set_flip_and_jump_pointers ptr
        }

        //  Time Complexity: w(0.5@+4)
        // Space Complexity: w(0.5@+22)
        //   Sets to_flip - and with it to_jump and the shared shadow - to point to the given pointer.
        //   (  to_flip = to_jump{+w} = to_ptr_var = ptr  )
        //
        // @note: an ALIAS of set_flip_and_jump_pointers, for the reason given at set_jump_pointer.
        //   hex.ptr_flip, hex.ptr_wflip and hex.xor_*_to_ptr reach here.
        // ptr is a hex[:w/4] that holds an address.
        def set_flip_pointer ptr {
            .set_flip_and_jump_pointers ptr
        }

        // Space Complexity: n+w/4 + 330
        //   Initializes a stack of size n (maximal capacity of n hexes / return-addresses).
        // n is the size of the stack.
        // @output-param sp: the stack pointer. sp always points to the last pushed value (at start - to stack[-1])
        // @output-param stack: the global stack.
        def stack_init n @ stack_error_handler > sp, stack {
          sp:
            hex.vec w/4, .stack

            pad w
          stack:
            hex.hex stack_error_handler
            hex.vec n, 0

          stack_error_handler:
            stl.output "\n\nERROR: You returned on an empty stack.\n"
            ;0      // (would fail, so the stack trace would be printed).
        }
    }
}



// ---------- Jump:


ns hex {
    //  Time Complexity: w(0.5@+4)
    // Space Complexity: w(0.5@+22)
        //   like:  ;*ptr
    //   Jump to the address the pointer points to.
    // ptr is a hex[:w/4] that holds an address.
    def ptr_jump ptr < hex.pointers.to_jump {
        .pointers.set_jump_pointer ptr
        ;hex.pointers.to_jump
    }
}
