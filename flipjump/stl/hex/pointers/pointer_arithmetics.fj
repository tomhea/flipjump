// ---------- Ptr ++/--/+=/-=


ns hex {
    //  Time Complexity: 7@+29
    // Space Complexity: w(0.375@ + 3.25)  + 3@+55  (for log(w) in 16,32,64,128)
    //   ptr[:w/4] += 2w
    // @requires hex.add.init (or hex.init)
    def ptr_inc ptr {
        hex.add_constant w/4, ptr, dw
    }

    //  Time Complexity: 7@+37
    // Space Complexity: w(0.375@ + 3.25)  + 3@+67  (for log(w) in 16,32,64,128)
    //   ptr[:w/4] -= 2w
    // @requires hex.sub.init (or hex.init)
    def ptr_dec ptr {
        hex.sub_constant w/4, ptr, dw
    }

    //  Time Complexity: 10@+43
    // Space Complexity: w(0.375@ + 3.25) + 4.5@+96
    //   ptr[:w/4] += value * 2w    (advance ptr by value)
    // @requires hex.add.init (or hex.init)
    // @note: The complexity is calculated with n_const=2, and for log(w) in 16,32,64,128.
    // value may be negative (ptr then moves back, modulo 2^w), but ptr_sub of -value is cheaper.
    def ptr_add ptr, value {
        hex.add_constant w/4, ptr, value * dw
    }

    //  Time Complexity: 10@+51
    // Space Complexity: w(0.375@ + 3.25)  + 4.5@+108
    //   ptr[:w/4] -= value * 2w    (retreat ptr by value)
    // @requires hex.sub.init (or hex.init)
    // @note: The complexity is calculated with n_const=2, and for log(w) in 16,32,64,128.
    // value may be negative (ptr then moves forward, modulo 2^w), but ptr_add of -value is cheaper.
    def ptr_sub ptr, value {
        hex.sub_constant w/4, ptr, value * dw
    }

    //  Time Complexity:  w(2@+5.75) + 3@+14
    // Space Complexity:  w(2@+40.5) + 3@+26
    // @note: The complexity is calculated for w=64. For w=32/16, add 0.25@/0.5@ in both complexities.
    //   dst[:w/4] = ptr + index*2w     (the address of the index-th dw-aligned op past *ptr)
    // dst, ptr are hex[:w/4]; index is a signed hex[:w/4]. Works for negative index too.
    // dst must not alias ptr.
    // @requires hex.add.init (or hex.init)
    // @Assumes: w in {16, 32, 64, 128}.
    def ptr_index dst, ptr, index {
        .mov w/4, dst, index
        .shl_hex w/4, dst
        rep(8-#w, i) .shr_bit w/4, dst
        .shl_hex w/4, dst
        .add w/4, dst, ptr
    }

    //  Time Complexity: n(8@+23) + w(0.5@)          (if n+2 <= w/8; else n(4@+9) + w(@+3.5))
    // Space Complexity: n(6.5@+149) + w(0.875@+9.25)  (if n+2 <= w/8; else n(4@+96) + w(@+16.5))
    // @note: The complexity is calculated for w=64 (index*2w needs n+2 hexes).
    //   dst[:w/4] = ptr + index*2w     (the address of the index-th dw-aligned op past *ptr)
    // dst, ptr are hex[:w/4]; index is an unsigned hex[:n] (n <= w/4).
    // dst must not alias ptr, and must be index itself or not overlap it.
    // At n == w/4 this is ptr_index dst, ptr, index: modulo 2^w, an index[:w/4] gives the same address whether it is
    //   read as unsigned or as negative.
    // The index is scaled only in the hexes index*2w needs (enough for any index[:n]), not in all w/4.
    // @requires hex.add.init (or hex.init)
    // @Assumes: w in {16, 32, 64, 128}.
    def ptr_index n, dst, ptr, index {
        .pointers.ptr_index n, (n+(#w+3)/4 < w/4) ? n+(#w+3)/4 : w/4, dst, ptr, index
    }

    ns pointers {
        //  Time Complexity: sw(7@+23) + w(0.5@)          (if sw <= w/8; else sw(3@+9) + w(@+3.5))
        // Space Complexity: sw(5.5@+137) + w(0.875@+9.25) (if sw <= w/8; else sw(3@+84) + w(@+16.5))
        //   dst[:w/4] = ptr + index*2w    (hex.ptr_index n's body; sw is the number of hexes index*2w needs)
        // If sw <= w/8, the index is scaled in a buffer of sw hexes, then added to a copy of ptr. Otherwise it is
        //   scaled in dst itself, and ptr is added to it.
        // @requires hex.add.init (or hex.init)
        def ptr_index n, sw, dst, ptr, index {
            rep(sw <= w/8, i) .ptr_index_narrow n, sw, dst, ptr, index
            rep(sw > w/8, i) .ptr_index_wide n, sw, dst, ptr, index
        }

        //  Time Complexity: sw(7@+23) + w(0.5@)
        // Space Complexity: sw(5.5@+137) + w(0.875@+9.25)
        //   dst[:w/4] = ptr + index*2w    (index*2w fits sw hexes)
        // @requires hex.add.init (or hex.init)
        def ptr_index_narrow n, sw, dst, ptr, index @ scaled, end {
            ..zero sw, scaled
            ..xor n, scaled, index
            .shl_index sw, scaled, #w
            ..mov w/4, dst, ptr
            ..add_shifted w/4, sw, dst, scaled, 0
            ;end
          scaled: ..vec sw
          end:
        }

        //  Time Complexity: sw(3@+9) + w(@+3.5)
        // Space Complexity: sw(3@+84) + w(@+16.5)
        //   dst[:w/4] = ptr + index*2w    (index*2w fits sw hexes)
        // @requires hex.add.init (or hex.init)
        def ptr_index_wide n, sw, dst, ptr, index {
            ..zero w/4-n, dst+n*dw
            ..mov n, dst, index
            .shl_index sw, dst, #w
            ..add w/4, dst, ptr
        }

        //  Time Complexity: sw(@+4) + (k%4)sw(@+1)       (sw(3@+9) when k%4 == 3)
        // Space Complexity: sw(@+28) + (k%4)sw(@+28)     (sw(3@+84) when k%4 == 3)
        //   x[:sw] <<= k
        // k is a constant: x is shifted k/4 hexes, then k%4 bits (a k%4 of 3 is one bit right and one hex left).
        // @Assumes: k >= 4.
        def shl_index sw, x, k {
            ..shl_hex sw, k/4, x
            rep(k%4 == 3, i) ..shr_bit sw, x
            rep(k%4 == 3, i) ..shl_hex sw, x
            rep(k%4 == 3 ? 0 : k%4, i) ..shl_bit sw, x
        }
    }
}
