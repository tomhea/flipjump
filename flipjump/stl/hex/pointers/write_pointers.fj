// ---------- Write Pointers


ns hex {
    //  Time Complexity: w( 0.5@+4)  + 11@+25
    // Space Complexity: w( 0.5@+22) + 11@+112
    //   like:  *ptr = src
    // src is a hex. ptr is a hex[:w/4] that holds an address, which we assume is dw-aligned.
    def write_hex ptr, src < hex.pointers.read_byte {
        .pointers.set_flip_and_jump_pointers ptr
        .pointers.read_byte_from_inners_ptrs
        .xor hex.pointers.read_byte, src
        .pointers.xor_hex_to_flip_ptr hex.pointers.read_byte
    }

    //  Time Complexity: w( 0.5@+4) + (5+5*PTR_CELL_BITS/4)@+13 + 12(PTR_CELL_BITS/4)   (15@+37 at the default 8)
    // Space Complexity: w( 0.5@+22) + (5+5*PTR_CELL_BITS/4)@+24 + 76(PTR_CELL_BITS/4)
    //   like:  *ptr = 0
    //   Zeroes the whole NARROW cell - all PTR_CELL_BITS bits. The read dance decodes that many
    //   bits into read_byte, so the write-back must cover the same width: flipping back only the
    //   low byte of a 12/16-bit cell would leave the top of the cell standing.
    // ptr is a hex[:w/4] that holds an address, which we assume is dw-aligned.
    def zero_ptr ptr < hex.pointers.read_byte {
        .pointers.set_flip_and_jump_pointers ptr
        .pointers.read_byte_from_inners_ptrs
        rep(.pointers.PTR_CELL_BITS/4, i) .pointers.xor_hex_to_flip_ptr hex.pointers.read_byte+i*dw, 4*i
    }

    //  Time Complexity: w( 0.5@+4)  + 17@+37
    // Space Complexity: w( 0.5@+22) + 17@+200
    //   like:  *ptr = src[:2]
    // src is a hex[:2]. ptr is a hex[:w/4] that holds an address, which we assume is dw-aligned.
    def write_byte ptr, src < hex.pointers.read_byte {
        .pointers.set_flip_and_jump_pointers ptr
        .pointers.read_byte_from_inners_ptrs
        .xor 2, hex.pointers.read_byte, src
        .pointers.xor_byte_to_flip_ptr hex.pointers.read_byte
    }

    //  Time Complexity: w(0.5@+4) + (5+PTR_WIDE/4+5*PTR_WIDE/4)@+37
    // Space Complexity: w(0.5@+22) + (5+PTR_WIDE/4+5*PTR_WIDE/4)@+24 + 88(PTR_WIDE/4)
    //   like:  *ptr = src[:PTR_WIDE/4]
    //   Writes a WHOLE CELL - all PTR_WIDE bits - in ONE dereference.
    //
    // The read-side twin is hex.read_cell, and the two must stay width-twins: a cell written
    // narrower than it is read back does not produce a wrong value, it returns whatever was
    // left standing in the top of the cell.
    // src is a hex[:PTR_WIDE/4]. ptr is a hex[:w/4] holding a dw-aligned address.
    // @note: at the defaults (PTR_CELL_BITS=8, no wide table) this is exactly write_byte.
    def write_cell ptr, src < hex.pointers.read_byte {
        .pointers.set_flip_and_jump_pointers ptr
        rep(.pointers.PTR_WIDE_BITS > 0, i) .pointers.read_wide_from_inners_ptrs
        rep(.pointers.PTR_WIDE_BITS == 0, i) .pointers.read_byte_from_inners_ptrs
        .xor .pointers.PTR_WIDE/4, hex.pointers.read_byte, src
        .pointers.xor_cell_to_flip_ptr hex.pointers.read_byte
    }

    //  Time Complexity: w(0.5@+4) + (5+5*PTR_WIDE/4)@+37
    // Space Complexity: w(0.5@+22) + (5+5*PTR_WIDE/4)@+24 + 76(PTR_WIDE/4)
    //   like:  *ptr = 0     for a whole cell, all PTR_WIDE bits of it.
    //
    // @note: on a WIDE cell only this macro may zero; hex.zero_ptr is the NARROW one and must
    //   not be pointed at a wide cell. Width is a property of the REGION, not of the call: the
    //   read dance arms a slot by flipping dbit+width, and a wide cell armed at
    //   dbit+PTR_CELL_BITS lands outside the narrow table entirely. That is not a wrong value,
    //   it is an unbounded jump.
    // ptr is a hex[:w/4] that holds an address, which we assume is dw-aligned.
    def zero_cell_ptr ptr < hex.pointers.read_byte {
        .pointers.set_flip_and_jump_pointers ptr
        rep(.pointers.PTR_WIDE_BITS > 0, i) .pointers.read_wide_from_inners_ptrs
        rep(.pointers.PTR_WIDE_BITS == 0, i) .pointers.read_byte_from_inners_ptrs
        .pointers.xor_cell_to_flip_ptr hex.pointers.read_byte
    }
}



// ---------- Multi Read Write Pointers


ns hex {
    //  Time Complexity: w( 0.5@+4)  + 20@+39
    // Space Complexity: w(0.88@+25) + 16@+167
    //   like:  *ptr = src
    //          ptr++
    // src is a hex. ptr is a hex[:w/4] that holds an address, which we assume is dw-aligned.
    def write_hex_and_inc ptr, src {
        .write_hex ptr, src
        .ptr_inc ptr
    }

    //  Time Complexity:  n(w( 0.5@+4)  + 20@+39)
    // Space Complexity:  n(w(0.88@+25) + 16@+167)
    //   like:  *ptr[:n] = src[:n]
    // src is a hex[:n]. ptr is a hex[:w/4] that holds an address, which we assume is dw-aligned.
    def write_hex n, ptr, src {
        rep(n, i) .write_hex_and_inc ptr, src + i*dw
        .ptr_sub ptr, n
    }

    //  Time Complexity: w( 0.5@+4)  + 26@+51
    // Space Complexity: w(0.88@+25) + 22@+255
    //   like:  *ptr = src[:2]
    //          ptr++
    // src is a hex[:2]. ptr is a hex[:w/4] that holds an address, which we assume is dw-aligned.
    def write_byte_and_inc ptr, src {
        .write_byte ptr, src
        .ptr_inc ptr
    }

    //  Time Complexity: n(w( 0.5@+4)  + 26@+51)
    // Space Complexity: n(w(0.88@+25) + 22@+255)
    //   like:  *ptr[:n] = src[:2n]
    // src is a hex[:2n]. ptr is a hex[:w/4] that holds an address, which we assume is dw-aligned.
    def write_byte n, ptr, src {
        rep(n, i) .write_byte_and_inc ptr, src + i*2*dw
        .ptr_sub ptr, n
    }

    //  Time Complexity: w(0.88@+7) + (5+PTR_WIDE/4+5*PTR_WIDE/4)@+51
    // Space Complexity: w(1.26@+25) + (5+PTR_WIDE/4+5*PTR_WIDE/4)@+24 + 88(PTR_WIDE/4) + 55
    //   like:  *ptr = src[:PTR_WIDE/4]
    //          ptr++
    //   The pair-walking form of write_cell; its read twin is read_cell_and_inc.
    // src is a hex[:PTR_WIDE/4]. ptr is a hex[:w/4] that holds an address, which we assume is dw-aligned.
    def write_cell_and_inc ptr, src {
        .write_cell ptr, src
        .ptr_inc ptr
    }
}

// ---------- Indexed (nth) Write Pointers


ns hex {
    //  Time Complexity:  w(2.75@+9.25) + 11@+25
    // Space Complexity:  w(2.75@+62)    + 11@+112
    // @note: The complexity is calculated for w=64. For w=32/16, add 0.25@/0.5@ in both complexities.
    //   *(ptr + index*2w) = src   — write src into the index-th hex past *ptr.
    // src is a hex; ptr is a hex[:w/4]; index is a signed hex[:w/4] (may be negative). ptr,index,src preserved.
    // @requires hex.init and stl.ptr_init (or stl.startup_and_init_all).
    def write_nth_hex ptr, index, src < hex.pointers.nth_ptr {
        .ptr_index hex.pointers.nth_ptr, ptr, index
        .write_hex hex.pointers.nth_ptr, src
    }

    //  Time Complexity:  w(2.75@+9.25) + 17@+37
    // Space Complexity:  w(2.75@+62)    + 17@+200
    // @note: The complexity is calculated for w=64. For w=32/16, add 0.25@/0.5@ in both complexities.
    //   *(ptr + index*2w)[:2] = src[:2]   — write the index-th byte past *ptr.
    // src is a hex[:2]; ptr is a hex[:w/4]; index is a signed hex[:w/4] (may be negative). ptr,index,src preserved.
    // @requires hex.init and stl.ptr_init (or stl.startup_and_init_all).
    def write_nth_byte ptr, index, src < hex.pointers.nth_ptr {
        .ptr_index hex.pointers.nth_ptr, ptr, index
        .write_byte hex.pointers.nth_ptr, src
    }
}
