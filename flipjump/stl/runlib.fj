// w = ??       // memory and operands width. Is defined at compile time.
dw   = 2 * w    // double word size
dbit = w + #w   // the bit-distance from the variable's start, to the bit/hex value (w + dw-width)

ns hex {
    ns pointers {
        // How many BITS one pointed-to memory cell holds, and therefore how big the decoder
        // table ptr_init lays down is: 2^PTR_CELL_BITS entries, at op exactly 2^PTR_CELL_BITS.
        //
        // Reading a cell works by adding 2^PTR_CELL_BITS to the slot's jump value so that it lands
        // on its own table entry (see ptr_init), which is a flip of bit dbit+PTR_CELL_BITS -- so
        // the ceiling is dbit+PTR_CELL_BITS < dw, i.e. 25 at w=32 and 56 at w=64. It must also be a
        // multiple of 4, because the value is decoded into a hex vector.
        //
        // Declared HERE, in the first stl file, so that it is a backward reference by the time
        // basic_pointers.fj uses it as a `pad` and a `rep` count. Override it per build with
        //     fj ... -D hex.pointers.PTR_CELL_BITS=16
        // A wider cell costs 2^PTR_CELL_BITS ops of table and PTR_CELL_BITS/4 hexes of zeroing per
        // read; it buys reading that many bits in ONE dereference instead of one per byte.
        PTR_CELL_BITS = 8

        // The WIDE cell width, in bits, or 0 for "do not lay a wide table at all".
        //
        // A program does not have to choose ONE cell width. The bit that gets flipped is
        // what selects the table -- dbit+PTR_CELL_BITS sends a slot to the narrow table at
        // op 2^PTR_CELL_BITS, dbit+PTR_WIDE_BITS sends it to the wide one at op
        // 2^PTR_WIDE_BITS -- so both tables can sit in the same program and each pointer
        // macro picks the one it wants. The two never overlap (256..511 and 65536..131071
        // at 8 and 16), they share ret_after_read_byte, and one read_byte register serves
        // both, sized to the wider of the two.
        //
        // That is the whole point: a narrow read costs exactly what it costs today, and
        // ONLY the sites that actually use hex.read_cell / hex.write_cell pay the wide
        // price. Widening PTR_CELL_BITS instead taxes every dereference in the program.
        //
        // Same rules as PTR_CELL_BITS when non-zero: a multiple of 4, at least 8, and
        // dbit+PTR_WIDE_BITS < dw. Costs 2^PTR_WIDE_BITS ops of table when on, 0 when off.
        //     fj ... -D hex.pointers.PTR_WIDE_BITS=16
        PTR_WIDE_BITS = 0

        // The width hex.read_cell / hex.write_cell actually move: the wide table when there
        // is one, otherwise the narrow cell. So `read_cell` always means "one whole cell,"
        // and a program that never sets PTR_WIDE_BITS still assembles and behaves exactly
        // as read_byte does.
        PTR_WIDE = .PTR_WIDE_BITS > 0 ? .PTR_WIDE_BITS : .PTR_CELL_BITS
    }
}


// More info about the FlipJump input / output in: https://esolangs.org/wiki/FlipJump#Input_/_Output


ns stl {
    // Complexity: 2
    // startup Macro - Should be the first piece of code in your program.
    //                 Inits the IO variable, and jumps to the next instruction.
    def startup @ code_start {
        stl.startup code_start
      code_start:
    }

    // Complexity: 2
    // startup Macro - Should be the first piece of code in your program.
    //                 Inits the IO variable, and jumps to the given code start.
    // @output-param IO: the address of the opcode that's reserved for Input/Output. More info in https://esolangs.org/wiki/FlipJump#Input_/_Output
    def startup code_start > IO {
        ;code_start    // 0w;1w : first code to run
      IO:
        ;0             // 2w;3w : sets the io_handler to address 0 (good for a future wflip)
    }

    // Complexity: 2.5w+265
    // startup Macro - Should be the first piece of code in your program.
    //                 Inits the IO variable, and the pointers globals.
    //                 Jumps to the next instruction.
    def startup_and_init_pointers @ code_start {
        stl.startup_and_init_pointers code_start
      code_start:
    }

    // Complexity: 2.5w+265
    // startup Macro - Should be the first piece of code in your program.
    //                 Inits the IO variable, and the pointers globals.
    //                 Jumps to the given code_start.
    def startup_and_init_pointers code_start {
        stl.startup code_start
        // NOTE: must be placed just after the startup, so that the read_ptr_byte_table will be in address 256.
        stl.ptr_init
    }

    // Complexity: ~7000  (7010 for w=64, 6890 for w=16)
    // startup Macro - Should be the first piece of code in your program.
    //                 Initialize anything needed for the standard library.
    def startup_and_init_all {
        .startup_and_init_all 100
    }

    // Complexity: 6725 + 2.5w+@ + n
    // startup Macro - Should be the first piece of code in your program.
    //                 Initialize anything needed for the standard library.
    // stack_bit_size is the size of the global-stack (will hold this number of hexes / return-addresses).
    def startup_and_init_all stack_bit_size @ code_start {
        .startup_and_init_all code_start, stack_bit_size
      code_start:
    }

    // Complexity: 6725 + 2.5w+@ + n
    // startup Macro - Should be the first piece of code in your program.
    //                 Initialize anything needed for the standard library.
    // stack_bit_size is the size of the global-stack (will hold this number of hexes / return-addresses).
    def startup_and_init_all code_start, stack_bit_size {
        stl.startup_and_init_pointers code_start
        hex.init
        stl.stack_init stack_bit_size
    }



    // ---------- Basic Functionality


    // Complexity: 1
    //   macro for 1 flipjump op
    def fj f, j {
        f;j
    }


    // Complexity: @
    //   macro for 1 wflip op
    def wflip_macro dst, val {
        wflip dst, val
    }


    // Complexity: @
    //   macro for 1 wflip op (with jump)
    def wflip_macro dst, val, jmp_addr {
        wflip dst, val, jmp_addr
    }



    // ---------- Compilation Time Comparisons:
    // Complexity: 1


    // if expression is 0 (compilation time), jump to l0. else jump to l1
    def comp_if expr, l0, l1 {
        ; expr ? l1 : l0
    }

    // if expression is 0 (compilation time), jump to l0. else continue
    def comp_if0 expr, l0 @ continue {
        .comp_if expr, l0, continue
      continue:
    }

    // if expression is not 0 (compilation time), jump to l1. else continue
    def comp_if1 expr, l1 @ continue {
        .comp_if expr, continue, l1
      continue:
    }


    // if expr != 0 (compilation time), flip the given bit.
    //
    // expr is a constant, and bit is a general bit-address.
    def comp_flip_if bit, expr {
        (expr ? bit : 0);
    }



    // ---------- Unconditional Jumps
    // Complexity: 1


    // skip the next flipjump op
    def skip {
        ;$ + dw
    }


    // finish (loop to self)
    def loop {
        ;$ - dw
    }



    // ---------- Output constants:


    // Complexity: 1
    // bit is a constant. 0 will output 0, anything else will output 1.
    def output_bit bit < .IO {
        .IO + (bit ? 1 : 0);
    }

    // Complexity: 8
    // ascii is a constant. The macro outputs the byte (ascii & 0xff)
    def output_char ascii {
        rep(8, i) .output_bit (ascii>>i)&1
    }

    // Complexity: 8 * string_length
    // str is a constant. The macro outputs the bytes of it (from lsB to msB) until it becomes all zeros.
    def output str {
        rep(((#str)+7)>>3, i) .output_char (str>>(8*i))&0xff
    }
}
