// C31 (the gap hunt's case_2100414_w16): a program whose own code passes pool_base at w=16 - a counting
// BlockPool must say the program reached the pool, not blame an operand.
stl.startup
L0:
hex.inc 2, v2+0*dw
hex.address_and_variable_xor 1, v2+dbit, v0+0*dw, v2
hex.print_as_digit 2, v0, 0
hex.count_bits 2, v0, v1+0*dw
hex.mov 1, v2+0*dw, v1+1*dw
hex.print_as_digit 2, v0, 0
stl.output '\n'
hex.print_as_digit 2, v1, 0
stl.output '\n'
hex.print_as_digit 2, v2, 0
stl.output '\n'
stl.loop
v0: hex.vec 2, 179
v1: hex.vec 2, 252
v2: hex.vec 2, 116
