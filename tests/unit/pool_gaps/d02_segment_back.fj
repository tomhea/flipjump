// D02: `H - 0x3000 + 12*dw` reaches back into a lower segment that is emitted later, and that holds a table
// below the place it lands on: the table stays inline.
dw = 2 * w
def startup @ code_start > IO {
    ;code_start
  IO:
    ;0
  code_start:
}
def outbit b < IO {
    IO + b;
}
def outc c {
    rep(8, i) outbit (c >> i) & 1
}
def halt @ l {
  l:
    ;l
}
ns my {
  ns __relocatable__ {
    def table start, e0, e1, e2, e3 {
      start:
        ;e0
        ;e1
        ;e2
        ;e3
    }
  }
}
def go x, e0, e1, e2, e3 @ T, end {
    wflip x+w, T, x
    pad 4
    my.__relocatable__.table T, e0, e1, e2, e3
  end:
    wflip x+w, T
}
// a declared table nobody runs: `;skip` jumps over it
def dead x @ T, skip, h {
    ;skip
    pad 4
    my.__relocatable__.table T, h, h, h, h
    wflip x+w, T
  h:
    ;h
  skip:
}
startup
    ;H
segment 0x4000
H:
    ;H - 0x3000 + 12*dw
segment 0x1000
    dead x
    ;r0
    ;r1
    ;r2
    ;r3
    ;r4
    ;r5
    ;r6
    ;r7
    ;r8
    ;r9
    ;r10
    ;r11
    ;r12
    ;r13
    ;r14
    ;r15
r0:
    outc 65
    halt
r1:
    outc 66
    halt
r2:
    outc 67
    halt
r3:
    outc 68
    halt
r4:
    outc 69
    halt
r5:
    outc 70
    halt
r6:
    outc 71
    halt
r7:
    outc 72
    halt
r8:
    outc 73
    halt
r9:
    outc 74
    halt
r10:
    outc 75
    halt
r11:
    outc 76
    halt
r12:
    outc 77
    halt
r13:
    outc 78
    halt
r14:
    outc 79
    halt
r15:
    outc 80
    halt
x:  ;0
