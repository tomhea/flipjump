// C16: a program that uses the (empty, zeroed) upper half of memory through a runtime pointer: it flips
// a bit at 0x80000000 + 2w + 3 (w=32), where the pool puts its first table.
stl.startup
    bit.ptr_flip p
    hex.xor y, x
    hex.print_as_digit y, 0
    stl.loop
p:  bit.vec w, (1<<31) + 2*w + 3
x:  hex.hex 5
y:  hex.hex 0
bit.pointers.ptr_init
