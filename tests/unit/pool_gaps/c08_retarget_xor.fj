// C8: user code retargets an ARMED pinned word from T1 to T2 in one wflip (`T1 ^ T2`). With the
// pin, insert_wflip_ops xors the block base into that flip too, so the base is no longer cancelled.
ns my {
  ns __relocatable__ {
    def table start, a {
      start:
        ;a
    }
  }
}
stl.startup
    ;begin
    pad 16
    my.__relocatable__.table T1, outA
    wflip x+w, T1
    ;outA
    pad 16
    my.__relocatable__.table T2, outB
    wflip x+w, T2
    ;outB
begin:
    wflip x+w, T1
    wflip x+w, T1 ^ T2, x
outA:
    stl.output 'A'
    stl.loop
outB:
    wflip x+w, T2
    stl.output 'B'
    stl.loop
x:  hex.hex 0
