stl.loop


def test_read_entry n, table, idx_n, i, expected @ idx, guard, dst, end {
    hex.read_entry n, dst, table, idx_n, idx
    check n, dst, expected
    ;end
  idx: hex.vec idx_n, i
  guard: hex.hex 0xd
  dst: hex.vec n, GARBAGE
  end:
}

def test_read_entry_byte table, idx_n, i, expected @ idx, guard, dst, end {
    hex.read_entry_byte dst, table, idx_n, idx
    check 2, dst, expected
    ;end
  idx: hex.vec idx_n, i
  guard: hex.hex 0xd
  dst: hex.vec 2, GARBAGE
  end:
}

def test_read_entry_packed nb, table, idx_n, i, expected @ idx, guard, dst, end {
    hex.read_entry_packed nb, dst, table, idx_n, idx
    check 2*nb, dst, expected
    ;end
  idx: hex.vec idx_n, i
  guard: hex.hex 0xd
  dst: hex.vec 2*nb, GARBAGE
  end:
}

// v[:idx_n] is the index (v[idx_n:] garbage); v[:n] = table[index].
def test_read_entry_self n, table, idx_n, i, expected @ v, end {
    hex.read_entry n, v, table, idx_n, v
    check n, v, expected
    ;end
  v: hex.vec n, (GARBAGE << (4*idx_n)) | i
  end:
}

// prints '=' if x[:n] == expected (mod 16^n), else '<' / '>'. Then a new line.
def check n, x, expected @ lt, eq, gt, expected_x, end {
    hex.cmp n, x, expected_x, lt, eq, gt
  lt:
    stl.output '<'
    ;end
  eq:
    stl.output '='
    ;end
  gt:
    stl.output '>'
    ;end
  expected_x: hex.vec n, expected
  end:
    stl.output '\n'
}


