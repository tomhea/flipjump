test_xor_hex_to_ptr_n low, 3, 17, 0xd36, 0x6febf6
test_read_byte_n low, 4, 0, 0xc70e43d4
test_read_hex_n low, 4, 0, 0x7e34
test_write_byte_n low, 4, 0, 0x8168db0c
test_write_hex_n low, 4, 0, 0xd6fd, 0x8d66df0d
test_xor_byte_to_ptr_n low, 4, 0, 0xd8537db4, 0x5535a2b9
test_xor_hex_to_ptr_n low, 4, 0, 0xf3c0, 0x5a36aeb9
test_read_byte_n low, 7, 7, 0x9b4f50f00cfc5e
test_read_hex_n low, 7, 7, 0xbf00cce
test_write_byte_n low, 7, 7, 0xd0c4d3897bfee
test_write_hex_n low, 7, 7, 0xa764e15, 0xa0746349eb1e5
test_xor_byte_to_ptr_n low, 7, 7, 0xeaeb6834a148bd, 0xe0ec2e003ff958
test_xor_hex_to_ptr_n low, 7, 7, 0x53b7890, 0xe5ef250737f058
test_read_byte_n low, 8, 4, 0x250737f0588ca4c2
test_read_hex_n low, 8, 4, 0x57708c42
test_write_byte_n low, 8, 4, 0xe00d33bf274e2446
test_write_hex_n low, 8, 4, 0xce656d85, 0xec0e36b5264d2845
test_xor_byte_to_ptr_n low, 8, 4, 0x1ecc867b3833f445, 0xf2c2b0ce1e7edc00
test_xor_hex_to_ptr_n low, 8, 4, 0xf0485dc9, 0xfdc2b4c61b73d009
test_read_byte_n low, 16, 0, 0xbdc7e5effdc2b4c61b73d0095a36aeb9
test_read_hex_n low, 16, 0, 0xd75fd246b309a6e9
test_write_byte_n low, 16, 0, 0x6f7a9335fcb67170dca5494354cdeda9
test_write_hex_n low, 16, 0, 0x773422a4de2e5198, 0x67779334f2b27a74ddae424e55c1e9a8
test_xor_byte_to_ptr_n low, 16, 0, 0xeb4c142dede31d864acbd10bfda60247, 0x8c3b87191f5167f297659345a867ebef
test_xor_hex_to_ptr_n low, 16, 0, 0xef3d8709dd68896, 0x8c35881a125960f29e689e43a06fe2e9
// the high array
test_read_byte_n high, 1, 3, 0xac
test_read_hex_n high, 1, 3, 0xc
test_write_byte_n high, 1, 3, 0xad
test_write_hex_n high, 1, 3, 0x0, 0xa0
test_xor_byte_to_ptr_n high, 1, 3, 0x80, 0x20
test_xor_hex_to_ptr_n high, 1, 3, 0x8, 0x28
test_read_byte_n high, 2, 2, 0x288c
test_read_hex_n high, 2, 2, 0x8c
