test_write_hex_n high, 7, 0, 0xe73629c, 0x8ee773e672791c
test_xor_byte_to_ptr_n high, 7, 0, 0x2adbb6eb74e62, 0x8c4ac888c5377e
test_xor_hex_to_ptr_n high, 7, 0, 0xa5fe568, 0x864fc786c03176
test_read_byte_n high, 8, 0, 0xac864fc786c03176
test_read_hex_n high, 8, 0, 0xc6f76016
test_write_byte_n high, 8, 0, 0x3de62be5077331a0
test_write_hex_n high, 8, 0, 0xa7e0bdb0, 0x3ae72ee00b7d3ba0
test_xor_byte_to_ptr_n high, 8, 0, 0x9a4139e877d984b2, 0xa0a617087ca4bf12
test_xor_hex_to_ptr_n high, 8, 0, 0x92edaffe, 0xa9a4190576abb01c
test_read_byte_n high, 16, 0, 0xf8b0559da4cec9b6a9a4190576abb01c
test_read_hex_n high, 16, 0, 0x805d4e9694956b0c
test_write_byte_n high, 16, 0, 0xfdd78de177ffbb4537b61e82d1f8552a
test_write_hex_n high, 16, 0, 0xc13e6fb98dc90833, 0xfcd183ee76ffbb4938bd1c89d0f85323
test_xor_byte_to_ptr_n high, 16, 0, 0x85d2b153127f22d85774b26fff132b02, 0x790332bd648099916fc9aee62feb7821
test_xor_hex_to_ptr_n high, 16, 0, 0xb1388bb431d7f82a, 0x720231b56c8b92956cc8a3e120e37a2b

stl.loop


def set_ptr array, k < p {
    hex.set w/4, p, array + k*dw
}

// three lines: dst[:2n] == expected; the pointer is where it was; read_back == the last cell.
def test_read_byte_n array, n, k, expected @ dst, end < p, v {
    set_ptr array, k
    hex.read_byte n, dst, p
    check 2*n, dst, expected
    check w/4, p, array + k*dw
    hex.read_back v
    check 2, v, (expected >> (8*(n-1))) & 0xff
    ;end
  dst: hex.vec 2*n, 0x5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c & ((1 << (8*n)) - 1)     // dirty: the op zeroes it first
  end:
}

// three lines: dst[:n] == expected (the cells' low hexes); the pointer; read_back == the last cell's low hex.
def test_read_hex_n array, n, k, expected @ dst, end < p, v {
    set_ptr array, k
    hex.read_hex n, dst, p
    check n, dst, expected
    check w/4, p, array + k*dw
    hex.read_back v
    check 1, v, (expected >> (4*(n-1))) & 0xf
    ;end
  dst: hex.vec n, 0x5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c5a3c & ((1 << (4*n)) - 1)     // dirty: the op zeroes it first
  end:
}

// n+2 lines: the cells one by one, the pointer, read_back == the last cell.
def test_write_byte_n array, n, k, bytes @ src, end < p, v {
    set_ptr array, k
    hex.write_byte n, p, src
    check w/4, p, array + k*dw
    hex.read_back v
    check 2, v, (bytes >> (8*(n-1))) & 0xff
    rep(n, i) check_cell array, k + i, (bytes >> (8*i)) & 0xff
    ;end
  src: hex.vec 2*n, bytes
  end:
}

def test_write_hex_n array, n, k, hexes, expected_cells @ src, end < p, v {
    set_ptr array, k
    hex.write_hex n, p, src
    check w/4, p, array + k*dw
    hex.read_back v
    check 2, v, (expected_cells >> (8*(n-1))) & 0xff
    rep(n, i) check_cell array, k + i, (expected_cells >> (8*i)) & 0xff
    ;end
  src: hex.vec n, hexes
  end:
}

def test_xor_byte_to_ptr_n array, n, k, bytes, expected_cells @ src, end < p, v {
    set_ptr array, k
    hex.xor_byte_to_ptr n, p, src
    check w/4, p, array + k*dw
    hex.read_back v
    check 2, v, (expected_cells >> (8*(n-1))) & 0xff
    rep(n, i) check_cell array, k + i, (expected_cells >> (8*i)) & 0xff
    ;end
  src: hex.vec 2*n, bytes
  end:
}

def test_xor_hex_to_ptr_n array, n, k, hexes, expected_cells @ src, end < p, v {
    set_ptr array, k
    hex.xor_hex_to_ptr n, p, src
    check w/4, p, array + k*dw
    hex.read_back v
    check 2, v, (expected_cells >> (8*(n-1))) & 0xff
    rep(n, i) check_cell array, k + i, (expected_cells >> (8*i)) & 0xff
    ;end
  src: hex.vec n, hexes
  end:
}

// reads cell k of the array (through q) and checks it.
def check_cell array, k, value < q, v {
    hex.set w/4, q, array + k*dw
    hex.read_byte v, q
    check 2, v, value
}

// prints '=' if x[:n] == expected, else '<' / '>'. Then a new line.
def check n, x, expected @ lt, eq, gt, expected_x, end {
    hex.cmp n, x, expected_x, lt, eq, gt
  lt:
    stl.output '<'
    ;end
  eq:
    stl.output '='
    ;end
  gt:
    stl.output '>'
    ;end
  expected_x: hex.vec n, expected
  end:
    stl.output '\n'
}


p: hex.vec w/4
q: hex.vec w/4
v: hex.vec 2
low:
  ;212*dw
  ;67*dw
  ;14*dw
  ;199*dw
  ;194*dw
  ;164*dw
  ;140*dw
  ;94*dw
  ;252*dw
  ;12*dw
  ;240*dw
  ;80*dw
  ;79*dw
  ;243*dw
  ;61*dw
  ;13*dw
  ;64*dw
  ;72*dw
  ;92*dw
  ;172*dw
  ;62*dw
  ;87*dw
  ;121*dw
  ;119*dw

  pad 2048
  rep(2045, i) stl.fj 0, 0
high:
  ;228*dw
  ;31*dw
  ;140*dw
  ;172*dw
  ;2*dw
  ;163*dw
  ;86*dw
  ;172*dw
  ;182*dw
  ;201*dw
  ;206*dw
  ;164*dw
  ;157*dw
  ;85*dw
  ;176*dw
  ;248*dw
  ;137*dw
  ;225*dw
  ;40*dw
  ;244*dw
  ;131*dw
  ;85*dw
  ;85*dw
  ;144*dw
