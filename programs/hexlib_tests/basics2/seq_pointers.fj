// Tests the n-cell pointer ops (read_byte / read_hex / write_byte / write_hex / xor_byte_to_ptr / xor_hex_to_ptr n),
//   n = 1, 2, 3, 4, 7, 8, 16, on random bytes: the values, every cell written (read back one by one), the pointer left
//   where it was, and the armed address left at the last cell (read_back). The "high" array straddles op 2048, so
//   moving the armed address to the next cell carries through 11 bits there.
// Values are random (python, seed 4242); each check prints '=' when the result is right.
stl.startup_and_init_all

// the low array
test_read_byte_n low, 1, 15, 0xd
test_read_hex_n low, 1, 15, 0xd
test_write_byte_n low, 1, 15, 0x8e
test_write_hex_n low, 1, 15, 0x2, 0x82
test_xor_byte_to_ptr_n low, 1, 15, 0x33, 0xb1
test_xor_hex_to_ptr_n low, 1, 15, 0xc, 0xbd
test_read_byte_n low, 2, 13, 0x3df3
test_read_hex_n low, 2, 13, 0xd3
test_write_byte_n low, 2, 13, 0xf1ee
test_write_hex_n low, 2, 13, 0xf7, 0xffe7
test_xor_byte_to_ptr_n low, 2, 13, 0x3572, 0xca95
test_xor_hex_to_ptr_n low, 2, 13, 0xde, 0xc79b
test_read_byte_n low, 3, 17, 0xac5c48
test_read_hex_n low, 3, 17, 0xcc8
