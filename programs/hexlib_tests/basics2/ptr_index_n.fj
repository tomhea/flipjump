stl.loop


hex.init


def test_ptr_index_n n, base, idx, expected @ ptr, index, guard, dst, end {
    hex.ptr_index n, dst, ptr, index
    check w/4, dst, expected
    ;end
  ptr: hex.vec w/4, base
  index: hex.vec n, idx
  guard: hex.hex 0xd
  dst: hex.vec w/4, GARBAGE
  end:
}

// v[:n] is the index, v[n:] garbage; v = ptr + index*2w. At n == w/4, also through ptr_index dst, ptr, index.
def test_ptr_index_self n, base, idx, expected @ ptr, v, v2, end {
    hex.ptr_index n, v, ptr, v
    check w/4, v, expected
    rep(n == w/4, i) hex.ptr_index v2, ptr, v2
    rep(n == w/4, i) check w/4, v2, expected
    ;end
  ptr: hex.vec w/4, base
  v: hex.vec w/4, (GARBAGE << (4*n)) | idx
  v2: hex.vec w/4, idx
  end:
}

// one line for ptr_index w/4, one for ptr_index.
def test_ptr_index_full base, idx, expected @ ptr, index, dst, end {
    hex.ptr_index w/4, dst, ptr, index
    check w/4, dst, expected
    hex.ptr_index dst, ptr, index
    check w/4, dst, expected
    ;end
  ptr: hex.vec w/4, base
  index: hex.vec w/4, idx
  dst: hex.vec w/4, GARBAGE
  end:
}

// prints '=' if x[:n] == expected (mod 16^n), else '<' / '>'. Then a new line.
def check n, x, expected @ lt, eq, gt, expected_x, end {
    hex.cmp n, x, expected_x, lt, eq, gt
  lt:
    stl.output '<'
    ;end
  eq:
    stl.output '='
    ;end
  gt:
    stl.output '>'
    ;end
  expected_x: hex.vec n, expected
  end:
    stl.output '\n'
}
