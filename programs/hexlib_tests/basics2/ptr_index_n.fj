// dst == index (its hexes above index[:n] are garbage), at every n
test_ptr_index_self 1, 0xe09d7658d61c11da, 0x0, 0xe09d7658d61c11da
test_ptr_index_self 1, 0xfb48c7e048ca9733, 0x9, 0xfb48c7e048ca9bb3
