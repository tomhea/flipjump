stl.loop


hex.init


// fixed_mul and fixed_mul_low (one line each), each into its own result, which starts as garbage.
def test_fixed_mul n, f, a, b, expected @ x, y, res, res_low, end {
    hex.fixed_mul n, f, res, x, y
    check n, res, expected
    hex.fixed_mul_low n, f, res_low, x, y
    check n, res_low, expected
    ;end
  x: hex.vec n, a
  y: hex.vec n, b
  res: hex.vec n, GARBAGE
  res_low: hex.vec n, GARBAGE
  end:
}

// dst is a (which == 0) or b (which == 1).
def test_fixed_mul_alias n, f, a, b, expected, which @ x, y, end {
    rep(which == 0, i) hex.fixed_mul n, f, x, x, y
    rep(which == 1, i) hex.fixed_mul n, f, y, x, y
    check n, which ? y : x, expected
    ;end
  x: hex.vec n, a
  y: hex.vec n, b
  end:
}
def test_fixed_mul_low_alias n, f, a, b, expected, which @ x, y, end {
    rep(which == 0, i) hex.fixed_mul_low n, f, x, x, y
    rep(which == 1, i) hex.fixed_mul_low n, f, y, x, y
    check n, which ? y : x, expected
    ;end
  x: hex.vec n, a
  y: hex.vec n, b
  end:
}
def test_fixed_div_alias n, f, a, b, expected, which @ x, y, div0, end {
    rep(which == 0, i) hex.fixed_div n, f, x, x, y, div0
    rep(which == 1, i) hex.fixed_div n, f, y, x, y, div0
    check n, which ? y : x, expected
    ;end
  div0:
    stl.output "div0\n"
    ;end
  x: hex.vec n, a
  y: hex.vec n, b
  end:
}

def test_fixed_div n, f, a, b, expected @ x, y, res, div0, end {
    hex.fixed_div n, f, res, x, y, div0
    check n, res, expected
    ;end
  div0:
    stl.output "div0\n"
    ;end
  x: hex.vec n, a
  y: hex.vec n, b
  res: hex.vec n, GARBAGE
  end:
}

def test_fixed_div_by_zero n, f, a @ x, y, res, div0, end {
    hex.fixed_div n, f, res, x, y, div0
    stl.output "no div0\n"
    ;end
  div0:
    stl.output "=\n"
    ;end
  x: hex.vec n, a
  y: hex.vec n, 0
  res: hex.vec n
  end:
}

def test_mul_low n, a, b, expected @ x, y, res, end {
    hex.mul_low n, res, x, y
    check n, res, expected
    ;end
  x: hex.vec n, a
  y: hex.vec n, b
  res: hex.vec n, GARBAGE
  end:
}

// dst aliases src here (as it may).
def test_mul_const n, a, c, expected @ x, end {
    hex.mul_const n, x, x, c
    check n, x, expected
    ;end
  x: hex.vec n, a
  end:
}

def test_mul_const_apart n, a, c, expected @ x, y, end {
    hex.mul_const n, y, x, c
    check n, y, expected
    check n, x, a
    ;end
  x: hex.vec n, a
  y: hex.vec n, 0x9e3c
  end:
}

// prints '=' if x[:n] == expected (mod 16^n), else '<' / '>'. Then a new line.
def check n, x, expected @ lt, eq, gt, expected_x, end {
    hex.cmp n, x, expected_x, lt, eq, gt
  lt:
    stl.output '<'
    ;end
  eq:
    stl.output '='
    ;end
  gt:
    stl.output '>'
    ;end
  expected_x: hex.vec n, expected
  end:
    stl.output '\n'
}
